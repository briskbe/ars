# Sanity project — copy to .env.local and fill in real values.
# Get these from https://www.sanity.io/manage after `npx sanity init`.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Required in production: the contact forms write submissions into Sanity
# through /api/contact, and the seed script (scripts/seed-sanity.ts) uses it too.
# Without it the forms return an error instead of storing the message.
# Create at sanity.io/manage → API → Tokens → "Editor".
# Server-side only — never prefix this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Resend (resend.com) — transactional mail for the contact and application
# forms: the visitor gets a confirmation, the inbox below gets a notification.
# Without a key the forms still work; mail is simply skipped.
RESEND_API_KEY=
# Optional overrides:
# CONTACT_INBOX_EMAIL=info@ars-metals.be
# EMAIL_FROM="ARS Metals <noreply@ars-metals.be>"
