# Sanity project — copy to .env.local and fill in real values.
# Get these from https://www.sanity.io/manage after `npx sanity init`.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Required for form submissions (contact + sollicitaties) and the seed script.
# Create at sanity.io/manage → API → Tokens → "Editor" or "Admin".
SANITY_API_WRITE_TOKEN=
