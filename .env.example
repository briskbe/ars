# Sanity project — copy to .env.local and fill in real values.
# Get these from https://www.sanity.io/manage after `npx sanity init`.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Required in production: the contact forms write submissions into Sanity
# through /api/contact, and the seed script (scripts/seed-sanity.ts) uses it too.
# Without it the forms return an error instead of storing the message.
# Create at sanity.io/manage → API → Tokens → "Editor".
# Server-side only — never prefix this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# E-mailmeldingen bij een nieuw bericht of een nieuwe sollicitatie (optioneel).
# Verstuurd via de eigen mailbox van de site over SMTP — geen extra dienst nodig.
# Zonder deze variabelen wordt er simpelweg geen melding verstuurd; de
# formulieren blijven gewoon werken en alles komt in de CMS terecht.
# Wie de melding krijgt, stel je in de CMS in bij Site-instellingen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optioneel; standaard hetzelfde als SMTP_USER.
SMTP_FROM=
